<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pro.pair.product.model.dao.ProductMapper">
	<!-- 상품 조회용 -->
	<resultMap id="productResultMap"
		type="com.pro.pair.product.model.dto.ProductDTO">
		<id property="prodNo" column="PROD_NO" />
		<result property="prodNm" column="PROD_NM" />
		<result property="brandCd" column="BRAND_CD" />
		<result property="categoryNo" column="CATEGORY_NO" />
		<result property="price" column="PRICE" />
		<result property="salePrice" column="SALE_PRICE" />
		<result property="prodDesc" column="PROD_DESC" />
		<result property="prodDetailContent"
			column="PROD_DETAIL_CONTENT" />
		<result property="insDt" column="INS_DT" />
		<result property="uptDt" column="UPT_DT" />
		<result property="prodAvailYn" column="PROD_AVAIL_YN" />
		<association property="category"
			resultMap="categoryResultMap" /> <!-- 1:1 -->
		<association property="brand" resultMap="brandResultMap" /> <!-- 1:1 -->
		<association property="attachmentList"
			resultMap="thumbnailResultMap" />
		<!-- <collection property="option" resultMap="optionResultMap"/> 1:N -->
	</resultMap>

	<!-- 브랜드 조회용 -->
	<resultMap id="brandResultMap"
		type="com.pro.pair.product.model.dto.BrandDTO">
		<id property="brandCd" column="BRAND_CD" />
		<result property="brandNm" column="BRAND_NM" />
	</resultMap>

	<!-- 카테고리 조회용 -->
	<resultMap id="categoryResultMap"
		type="com.pro.pair.product.model.dto.CategoryDTO">
		<id property="categoryNo" column="CATEGORY_NO" />
		<result property="categoryNm" column="CATEGORY_NM" />
		<result property="upCategoryNo" column="UP_CATEGORY_NO" />
		<result property="lvl" column="LVL" />
		<result property="sortOrder" column="SORTORDER" />
		<result property="useYn" column="USE_YN" />
	</resultMap>

	<!-- 썸네일 조회용 -->
	<resultMap id="thumbnailResultMap"
		type="com.pro.pair.upload.model.dto.AttachmentDTO">
		<id property="attachmentNo" column="ATTACHMENT_NO" />
		<result property="refProdNo" column="REF_PROD_NO" />
		<result property="refRevwNo" column="REF_REVW_NO" />
		<result property="refInqNo" column="REF_INQ_NO" />
		<result property="origFileNm" column="ORIG_FILE_NM" />
		<result property="saveFileNm" column="SAVE_FILE_NM" />
		<result property="savePath" column="SAVE_PATH" />
		<result property="thumbnailPath" column="THUMBNAIL_PATH" />
		<result property="fileType" column="FILE_TYPE" />
		<result property="attachStatusYn" column="ATTACH_STATUS_YN" />
	</resultMap>

	<!-- 브랜드 목록 조회 -->
	<select id="getBrandList" resultMap="brandResultMap">
		SELECT BRAND_CD, BRAND_NM
		FROM TBL_BRAND
	</select>

	<!-- 카테고리에 목록 조회 -->
	<select id="getCategoryList" resultMap="categoryResultMap">
		SELECT *
		FROM TBL_CATEGORY
		WHERE USE_YN = 'Y'
		ORDER BY SORT_ORDER
	</select>

	<!-- 상위 카테고리에 따른 하위 목록 조회 -->
	<select id="getSubCategoryList" parameterType="int"
		resultMap="categoryResultMap">
		SELECT *
		FROM
		TBL_CATEGORY
		WHERE UP_CATEGORY_NO = #{categoryNo}
		AND USE_YN = 'Y'
		ORDER BY SORT_ORDER
	</select>

	<!-- 현재 상품번호 조회 -->
	<select id="checkCurrProdNo" resultType="int">
		SELECT
		SEQ_PROD_NO.CURRVAL
		FROM DUAL
	</select>

	<!-- 상품 등록 -->
	<insert id="addProduct">
		INSERT
		INTO TBL_PRODUCT
		(
			PROD_NO
			,PROD_NM
			,BRAND_CD
			,CATEGORY_NO
			,PRICE
			,SALE_PRICE
			,PROD_DESC
			,PROD_DETAIL_CONTENT
			,INS_DT
			,UPT_DT
			,USE_YN
		)
		VALUES
		(
		SEQ_PROD_NO.NEXTVAL
		, #{ prodNm }
		, #{ brandCd }
		, #{ categoryNo }
		, #{ price }
		, #{ salePrice }
		, #{ prodDesc }
		, #{ prodDetailContent }
		, SYSDATE
		, SYSDATE
		, DEFAULT
		)
	</insert>

	<!-- 상품 썸네일 등록 -->
	<insert id="attachProdThumbnail">
		INSERT
		INTO TBL_ATTACHMENT
		(
		ATTACHMENT_NO
		, REF_PROD_NO
		, REF_REVW_NO
		, REF_INQ_NO
		, ORIG_FILE_NM
		, SAVE_FILE_NM
		, SAVE_PATH
		, THUMBNAIL_PATH
		, FILE_TYPE
		, ATTACH_STATUS_YN
		)
		VALUES
		(
		SEQ_ATTACH_NO.NEXTVAL
		, #{ refProdNo }
		, NULL
		, NULL
		, #{ origFileNm }
		, #{ saveFileNm }
		, #{ savePath }
		, #{ thumbnailPath }
		, #{ fileType }
		, DEFAULT
		)
	</insert>


</mapper>