<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pro.pair.cart.model.dao.CartMapper">
	<!-- 장바구니 조회용 -->
	<resultMap id="cartResultMap"
		type="com.pro.pair.cart.model.dto.CartDTO">
		<id property="cartNo" column="CART_NO" />
		<result property="memberId" column="MEMBER_ID" />
		<result property="prodNo" column="PROD_NO" />
		<result property="optCombNo" column="OPT_COMB_NO" />
		<result property="quantity" column="QUANTITY" />
		<result property="insDt" column="INS_DT" />
		<result property="uptDt" column="UPT_DT" />
		<association property="product" resultMap="productResultMap"/> <!-- 1:1 -->
		<association property="category" resultMap="categoryResultMap"/> <!-- 1:1 -->
		<association property="brand" resultMap="brandResultMap"/> <!-- 1:1 -->
		<association property="optionComb" resultMap="optionCombResultMap"/> <!-- 1:1 -->
		<association property="attachmentList" resultMap="thumbnailResultMap"/> <!-- 1:1 -->
	</resultMap>
	
	<!-- 상품 조회용 -->
	<resultMap id="productResultMap"
		type="com.pro.pair.product.model.dto.ProductDTO">
		<id property="prodNo" column="PROD_NO" />
		<result property="prodNm" column="PROD_NM" />
		<result property="brandCd" column="BRAND_CD" />
		<result property="categoryNo" column="CATEGORY_NO" />
		<result property="price" column="PRICE" />
		<result property="discountRate" column="DISCOUNT_RATE" />
		<result property="prodDesc" column="PROD_DESC" />
		<result property="prodDetailContent" column="PROD_DETAIL_CONTENT" />
		<result property="insDt" column="INS_DT" />
		<result property="uptDt" column="UPT_DT" />
		<result property="useYn" column="USE_YN" />
		<association property="category" resultMap="categoryResultMap" /> <!-- 1:1 -->
		<association property="brand" resultMap="brandResultMap" /> <!-- 1:1 -->
		<association property="attachmentList" resultMap="thumbnailResultMap" />
		<!-- <collection property="option" resultMap="optionResultMap"/> 1:N -->
	</resultMap>

	<!-- 옵션조합 조회용 -->
	<resultMap id="optionCombResultMap" type="com.pro.pair.product.model.dto.OptionCombDTO">
		<id property="optCombNo" column="OPT_COMB_NO"/>
		<result property="prodNo" column="PROD_NO"/>
		<result property="optAddPrice" column="OPT_ADD_PRICE"/>
		<result property="optStockQty" column="OPT_STOCK_QTY"/>
		<result property="optManageNm" column="OPT_MANAGE_NM"/>
		<result property="saleStatus" column="SALE_STATUS"/>
	</resultMap>

	<!-- 브랜드 조회용 -->
	<resultMap id="brandResultMap"
		type="com.pro.pair.product.model.dto.BrandDTO">
		<id property="brandCd" column="BRAND_CD" />
		<result property="brandNm" column="BRAND_NM" />
	</resultMap>

	<!-- 카테고리 조회용 -->
	<resultMap id="categoryResultMap"
		type="com.pro.pair.product.model.dto.CategoryDTO">
		<id property="categoryNo" column="CATEGORY_NO" />
		<result property="categoryNm" column="CATEGORY_NM" />
		<result property="upCategoryNo" column="UP_CATEGORY_NO" />
		<result property="lvl" column="LVL" />
		<result property="sortOrder" column="SORTORDER" />
		<result property="useYn" column="USE_YN" />
	</resultMap>

	<!-- 썸네일 조회용 -->
	<resultMap id="thumbnailResultMap"
		type="com.pro.pair.upload.model.dto.AttachmentDTO">
		<id property="attachmentNo" column="ATTACHMENT_NO" />
		<result property="refProdNo" column="REF_PROD_NO" />
		<result property="refRevwNo" column="REF_REVW_NO" />
		<result property="refInqNo" column="REF_INQ_NO" />
		<result property="origFileNm" column="ORIG_FILE_NM" />
		<result property="saveFileNm" column="SAVE_FILE_NM" />
		<result property="savePath" column="SAVE_PATH" />
		<result property="thumbnailPath" column="THUMBNAIL_PATH" />
		<result property="fileType" column="FILE_TYPE" />
		<result property="attachStatusYn" column="ATTACH_STATUS_YN" />
	</resultMap>
	
	<!-- 장바구니 전체 리스트 조회 -->
	<select id="getCartList" resultMap="cartResultMap">
		SELECT A.CART_NO
			, A.MEMBER_ID
			, A.PROD_NO
			, A.OPT_COMB_NO
			, A.QUANTITY
			, A.INS_DT
			, A.UPT_DT
			, B.PROD_NM
			, B.DISCOUNT_RATE
			, B.PRICE
			, C.BRAND_NM
			, T.THUMBNAIL_PATH
			, O.OPT_ADD_PRICE
			, O.OPT_MANAGE_NM
		FROM TBL_CART A
		LEFT JOIN TBL_PRODUCT B ON A.PROD_NO = B.PROD_NO
		LEFT JOIN TBL_BRAND C ON B.BRAND_CD = C.BRAND_CD
		LEFT JOIN TBL_ATTACHMENT T ON A.PROD_NO = T.REF_PROD_NO
		LEFT JOIN TBL_OPTION_COMB O ON A.OPT_COMB_NO = O.OPT_COMB_NO
		WHERE MEMBER_ID = #{memberId}
		AND T.FILE_TYPE = 'THUMB_MAIN'
		ORDER BY C.BRAND_NM, A.CART_NO ASC
	</select>

	<!-- 이미 담긴 상품인지 확인 -->
	<select id="selectCartByOption" resultMap="cartResultMap">
		SELECT CART_NO
		,
		MEMBER_ID
		, PROD_NO
		, OPT_COMB_NO
		, QUANTITY
		FROM TBL_CART
		WHERE MEMBER_ID
		= #{memberId}
		AND OPT_COMB_NO = #{optCombNo}
	</select>

	<!-- 이미 담겨있는 상품인 경우 수량 증가 -->
	<update id="updateQuantity">
		UPDATE TBL_CART
		SET QUANTITY = #{quantity}
		,UPT_DT = SYSDATE
		WHERE member_id = #{memberId} AND opt_comb_no = #{optCombNo}
	</update>

	<insert id="insertCart">
		<selectKey resultType="_int" keyProperty="cartNo"
			order="BEFORE">
			SELECT
			NVL(MAX(CART_NO), 0) + 1
			FROM TBL_CART
		</selectKey>
		INSERT
		INTO TBL_CART
		(
		CART_NO
		, MEMBER_ID
		, PROD_NO
		, OPT_COMB_NO
		, QUANTITY
		, INS_DT
		, UPT_DT
		)
		VALUES
		(
		#{ cartNo }
		, #{ memberId }
		, #{ prodNo }
		, #{ optCombNo }
		, #{ quantity }
		,
		SYSDATE
		, SYSDATE
		)
	</insert>
</mapper>